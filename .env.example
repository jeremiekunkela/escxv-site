# Cle API Resend.
RESEND_API_KEY=

# Adresse expéditrice, sur le domaine vérifié dans Resend.
# Pour tester sans domaine vérifié : onboarding@resend.dev
CONTACT_FROM_EMAIL=
# Nom affiché de l'expéditeur (facultatif)
CONTACT_FROM_NAME=

# Destinataire forcé : tout part à cette adresse au lieu des boîtes de section.
# Actif dès qu'il est renseigné, quel que soit l'environnement — ne pas le
# laisser en production. Avec onboarding@resend.dev, utilisez l'adresse du
# compte Resend.
CONTACT_RECIPIENT_OVERRIDE_EMAIL=

# Secret de signature du jeton anti-robot : chaîne aléatoire longue.
# Obligatoire partout, y compris en local : sans lui, pas de formulaire.
# Générer avec : openssl rand -hex 32
CONTACT_TOKEN_SECRET=

# Mettre "console" pour éprouver le formulaire sans clé Resend : le message
# s'affiche dans la console du serveur et rien n'est envoyé. Ignoré dès que
# RESEND_API_KEY et CONTACT_FROM_EMAIL sont renseignés.
CONTACT_SENDER=

# Interrupteur des formulaires de contact. Vide = actifs. Mettre "false" pour
# les couper : les pages affichent alors les adresses email et /api/contact
# refuse. Ils restent masqués tant que l'envoi n'est pas configuré ci-dessus.
CONTACT_FORM_ENABLED=
