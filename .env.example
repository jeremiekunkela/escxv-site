# Formulaire de contact — Scaleway Transactional Email
# Sans ces variables, le développement écrit le message dans la console du
# serveur au lieu de l'envoyer, et la production refuse l'envoi.

# Clé API Scaleway restreinte à Transactional Email
SCW_SECRET_KEY=
# Identifiant du projet Scaleway qui porte le domaine d'envoi
SCW_DEFAULT_PROJECT_ID=
# Région d'envoi (fr-par par défaut)
SCW_DEFAULT_REGION=fr-par

# Adresse expéditrice, sur le domaine vérifié dans Transactional Email
CONTACT_FROM_EMAIL=
# Nom affiché de l'expéditeur (facultatif)
CONTACT_FROM_NAME=

# Secret de signature du jeton anti-robot : chaîne aléatoire longue.
# Obligatoire en production, où aucun repli n'est accepté.
# Générer avec : openssl rand -hex 32
CONTACT_TOKEN_SECRET=
