# Cle API Resend.
RESEND_API_KEY=

# Adresse expéditrice, sur le domaine vérifié dans Resend.
# Pour tester sans domaine vérifié : onboarding@resend.dev
CONTACT_FROM_EMAIL=
# Nom affiché de l'expéditeur (facultatif)
CONTACT_FROM_NAME=

# Destinataire forcé hors Production Vercel, utile pour Preview/preprod/develop.
# Avec onboarding@resend.dev, utilisez l'adresse du compte Resend.
CONTACT_RECIPIENT_OVERRIDE_EMAIL=

# Secret de signature du jeton anti-robot : chaîne aléatoire longue.
# Obligatoire sur Vercel, y compris en Preview.
# Générer avec : openssl rand -hex 32
CONTACT_TOKEN_SECRET=
